async function api(url, options = {}) {
    const response = await fetch(url, {
        ...options,
        headers: {
            "Content-Type": "application/json",
            ...options.headers
        }
    });

    const data = await response.json();

    if (!response.ok) {
        throw new Error(data.message || "Ошибка запроса");
    }

    return data;
}

// Вход
async function login() {
    const username = document.getElementById("username").value;
    const password = document.getElementById("password").value;

    try {
        await api("/api/login", {
            method: "POST",
            body: JSON.stringify({ username, password })
        });

        await showDashboard();

    } catch (error) {
        document.getElementById("message").textContent = error.message;
    }
}

// Панель управления
async function showDashboard() {
    try {
        const user = await api("/api/profile");

        document.getElementById("loginForm").classList.add("hidden");
        document.getElementById("dashboard").classList.remove("hidden");

        document.getElementById("welcome").textContent =
            "Добро пожаловать, " + user.username;

        document.getElementById("userRole").textContent =
            "Ваша роль: " + user.role;

        if (user.role === "admin") {
            document.getElementById("adminPanel").classList.remove("hidden");
            document.getElementById("userPanel").classList.add("hidden");

            await loadUsers();
            await loadEvents();
        } else {
            document.getElementById("adminPanel").classList.add("hidden");
            document.getElementById("userPanel").classList.remove("hidden");
        }

    } catch (error) {
        alert(error.message);
    }
}

// Загрузка пользователей
async function loadUsers() {
    const users = await api("/api/users");
    const container = document.getElementById("users");

    container.replaceChildren();

    users.forEach(user => {
        const item = document.createElement("div");
        item.className = "item";

        const info = document.createElement("p");
        info.textContent = `${user.username} | ${user.role}`;

        const select = document.createElement("select");

        ["admin", "student", "teacher"].forEach(role => {
            const option = document.createElement("option");
            option.value = role;
            option.textContent = role;
            option.selected = role === user.role;
            select.appendChild(option);
        });

        const button = document.createElement("button");
        button.textContent = "Изменить роль";

        button.onclick = async () => {
            try {
                await api(`/api/users/${user.id}/role`, {
                    method: "PATCH",
                    body: JSON.stringify({ role: select.value })
                });

                alert("Роль изменена");
                await loadUsers();
                await loadEvents();

            } catch (error) {
                alert(error.message);
            }
        };

        item.append(info, select, button);
        container.appendChild(item);
    });
}

// Загрузка журнала событий
async function loadEvents() {
    const events = await api("/api/events");
    const container = document.getElementById("events");

    container.replaceChildren();

    events.slice().reverse().forEach(event => {
        const item = document.createElement("div");
        item.className = "item";

        item.textContent =
            `${event.date} | ${event.username} | ${event.action} | ${event.details}`;

        container.appendChild(item);
    });
}

// Выход
async function logout() {
    try {
        await api("/api/logout", {
            method: "POST"
        });

        document.getElementById("dashboard").classList.add("hidden");
        document.getElementById("loginForm").classList.remove("hidden");

        document.getElementById("username").value = "";
        document.getElementById("password").value = "";
        document.getElementById("message").textContent = "";

    } catch (error) {
        alert(error.message);
    }
}
