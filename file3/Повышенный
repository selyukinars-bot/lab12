const express = require("express");
const session = require("express-session");

const app = express();

app.use(express.json());
app.use(express.static("public"));

app.use(session({
    secret: process.env.SESSION_SECRET || "library-secret-key",
    resave: false,
    saveUninitialized: false,
    cookie: {
        httpOnly: true,
        sameSite: "lax",
        secure: false,
        maxAge: 30 * 60 * 1000
    }
}));

// База пользователей (учебный вариант)
const users = [
    { id: 1, username: "admin", password: "12345", role: "admin" },
    { id: 2, username: "student", password: "12345", role: "student" },
    { id: 3, username: "teacher", password: "12345", role: "teacher" }
];

// Журнал событий
const events = [];

function addEvent(username, action, details = "") {
    events.push({
        id: events.length + 1,
        username,
        action,
        details,
        date: new Date().toLocaleString("ru-RU")
    });
}

// Проверка авторизации
function checkAuth(req, res, next) {
    if (!req.session.user) {
        return res.status(401).json({
            message: "Необходимо авторизоваться"
        });
    }

    next();
}

// Проверка роли
function checkRole(...roles) {
    return (req, res, next) => {
        if (!req.session.user ||
            !roles.includes(req.session.user.role)) {
            return res.status(403).json({
                message: "Недостаточно прав доступа"
            });
        }

        next();
    };
}

// Вход в систему
app.post("/api/login", (req, res) => {
    const { username, password } = req.body;

    const user = users.find(
        u => u.username === username &&
             u.password === password
    );

    if (!user) {
        addEvent(username || "Неизвестный пользователь", "Ошибка входа");

        return res.status(401).json({
            message: "Неверный логин или пароль"
        });
    }

    req.session.user = {
        id: user.id,
        username: user.username,
        role: user.role
    };

    addEvent(user.username, "Вход в систему");

    res.json({
        message: "Вход выполнен успешно",
        user: req.session.user
    });
});

// Информация о текущем пользователе
app.get("/api/profile", checkAuth, (req, res) => {
    res.json(req.session.user);
});

// Получение списка пользователей (только администратор)
app.get("/api/users", checkAuth, checkRole("admin"), (req, res) => {
    const safeUsers = users.map(({ id, username, role }) => ({
        id,
        username,
        role
    }));

    res.json(safeUsers);
});

// Изменение роли пользователя (только администратор)
app.patch("/api/users/:id/role",
    checkAuth,
    checkRole("admin"),
    (req, res) => {

        const user = users.find(
            u => u.id === Number(req.params.id)
        );

        const { role } = req.body;
        const allowedRoles = ["admin", "student", "teacher"];

        if (!user) {
            return res.status(404).json({
                message: "Пользователь не найден"
            });
        }

        if (!allowedRoles.includes(role)) {
            return res.status(400).json({
                message: "Недопустимая роль"
            });
        }

        const oldRole = user.role;
        user.role = role;

        addEvent(
            req.session.user.username,
            "Изменение роли",
            `${user.username}: ${oldRole} → ${role}`
        );

        res.json({
            message: "Роль успешно изменена"
        });
    }
);

// Просмотр журнала событий (только администратор)
app.get("/api/events", checkAuth, checkRole("admin"), (req, res) => {
    res.json(events);
});

// Выход из системы
app.post("/api/logout", checkAuth, (req, res) => {
    const username = req.session.user.username;

    addEvent(username, "Выход из системы");

    req.session.destroy(err => {
        if (err) {
            return res.status(500).json({
                message: "Ошибка выхода"
            });
        }

        res.json({
            message: "Выход выполнен успешно"
        });
    });
});

// Запуск сервера
app.listen(3000, () => {
    console.log("Сервер запущен: http://localhost:3000");
});
