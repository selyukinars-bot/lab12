const express = require("express");
const session = require("express-session");

const app = express();

app.use(express.json());

app.use(session({
    secret: "library-secret-key",
    resave: false,
    saveUninitialized: false,
    cookie: {
        httpOnly: true,
        maxAge: 30 * 60 * 1000
    }
}));

app.use(express.static("public"));

// Учебная база пользователей
const users = [
    {
        id: 1,
        username: "student",
        password: "12345",
        role: "student"
    },
    {
        id: 2,
        username: "teacher",
        password: "12345",
        role: "teacher"
    }
];

// Проверка входа
app.post("/api/login", (req, res) => {
    const { username, password } = req.body;

    const user = users.find(
        u => u.username === username &&
             u.password === password
    );

    if (!user) {
        return res.status(401).json({
            message: "Неверный логин или пароль"
        });
    }

    req.session.user = {
        id: user.id,
        username: user.username,
        role: user.role
    };

    res.json({
        message: "Вход выполнен",
        username: user.username,
        role: user.role
    });
});

// Проверка авторизации
function checkAuth(req, res, next) {
    if (!req.session.user) {
        return res.status(401).json({
            message: "Необходимо войти в систему"
        });
    }

    next();
}

// Проверка роли
function checkRole(role) {
    return (req, res, next) => {
        if (!req.session.user || req.session.user.role !== role) {
            return res.status(403).json({
                message: "Доступ запрещен"
            });
        }

        next();
    };
}

// Получение профиля
app.get("/api/me", checkAuth, (req, res) => {
    res.json(req.session.user);
});

// Страница студента
app.get("/api/student", checkAuth, checkRole("student"), (req, res) => {
    res.json({
        message: "Добро пожаловать, студент!",
        functions: [
            "Просмотр учебных материалов",
            "Поиск книг",
            "Просмотр заданий"
        ]
    });
});

// Страница преподавателя
app.get("/api/teacher", checkAuth, checkRole("teacher"), (req, res) => {
    res.json({
        message: "Добро пожаловать, преподаватель!",
        functions: [
            "Добавление учебных материалов",
            "Управление книгами",
            "Просмотр списка студентов"
        ]
    });
});

// Выход
app.post("/api/logout", (req, res) => {
    req.session.destroy(() => {
        res.json({ message: "Вы вышли из системы" });
    });
});

app.listen(3000, () => {
    console.log("Сервер запущен: http://localhost:3000");
});
